# Optional: copy to .env. Compose reads it for variable substitution.

# Grafana Cloud remote_write — set BOTH (and create secrets/grafana_cloud_rw), or leave both unset.
# GRAFANA_CLOUD_PROMETHEUS_URL=https://prometheus-prod-NN-...grafana.net/api/prom/push
# GRAFANA_CLOUD_PROMETHEUS_USER=123456

# Token file: secrets/grafana_cloud_rw (metrics:write). See secrets/README and:
# https://grafana.com/docs/grafana-cloud/send-data/metrics/metrics-prometheus/
